---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import { radovi } from '../data/radovi';
import { breadcrumbSchema, type Crumb } from '../lib';

const crumbs: Crumb[] = [
  { name: 'Početna', href: '/' },
  { name: 'O meni', href: '/o-meni' },
];

const principles = [
  ['Detalji nisu sitnica', 'Razmak, riječ, trenutak u kojem se nešto pomakne. Posjetitelj to ne mora primijetiti, ali osjeti.'],
  ['Jasan jezik', 'Bez stručnog žargona. Uvijek znate što radim, zašto i koliko to košta.'],
  ['Stranica ostaje Vaša', 'Domena i hosting glase na Vas. Nitko Vas ne drži taocem vlastite stranice.'],
];

const n = radovi.length;
const brojProjekata = n % 10 === 1 && n % 100 !== 11 ? `${n} projekt` : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? `${n} projekta` : `${n} projekata`;

// Alati i tehnologije koje stvarno koristim na stranicama (bez izmišljenih certifikata)
const tehnologije = [
  ['Astro i TypeScript', 'Brze, statične stranice bez nepotrebnog tereta, koje se učitavaju u trenu i na mobitelu.'],
  ['HTML, CSS i pristupačnost', 'Semantička struktura, dovoljni kontrasti i navigacija tipkovnicom, da stranicu mogu koristiti svi.'],
  ['Core Web Vitals', 'Brzina učitavanja (LCP), odziv (INP) i stabilnost (CLS) mjere se prije svake predaje.'],
  ['Tehnički i lokalni SEO', 'Naslovi, opisi, strukturirani podaci (schema.org), sitemap i stranice za mjesta u kojima radite.'],
  ['Vercel hosting i HTTPS', 'Brz hosting s certifikatom, automatskim objavama i sigurnosnim zaglavljima.'],
  ['AI chatbot', 'Asistent koji odgovara iz Vaših materijala, složen tako da se drži činjenica.'],
];
---

<Base
  title="Web dizajner Šibenik — Mirnes Okanović, o meni | Levanat"
  description="Mirnes Okanović, web dizajner iz Šibenika: web stranice za obrte i male poduzetnike, alati koje koristim i kako radim. Zatražite besplatnu ponudu!"
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero crumbs={crumbs} label="O meni">
    <h1>Mirnes Okanović, <em>web dizajner</em> iz Šibenika</h1>
  </PageHero>

  <section class="section">
    <div class="wrap grid about">
      <figure class="portrait">
        <!-- [FOTO_MIRNES] zamijenite s: <img src="/mirnes.webp" alt="Mirnes Okanović, web dizajner iz Šibenika" width="1200" height="1500" /> -->
        <div class="portrait__placeholder mono" aria-hidden="true">[FOTO_MIRNES]</div>
      </figure>
      <div class="about__body">
        <p class="label">Kako je počelo</p>
        <p class="lead" data-reveal="fade">
          Sve je počelo kada me djevojka zamolila da joj izradim web stranicu. Tijekom tog projekta shvatio sam da imam
          oko za dizajn i da me taj posao istinski ispunjava.
        </p>
        <p data-reveal="fade">
          Ne žalim sate provedene u promišljanju svakog elementa, jer znam da upravo sitni detalji čine razliku. Onaj
          razmak koji diše, riječ koja je točno na mjestu, gumb koji se ponaša baš kako treba.
        </p>
        <p data-reveal="fade">Najdraža poruka koju mogu dobiti je ona koja stigne tjedan dana nakon predaje:</p>
        <blockquote class="quote" data-reveal="fade">
          <p>„Tek sam sad vidio ovo, pa ti si i o tome razmišljao.”</p>
        </blockquote>
        <p data-reveal="fade">Zbog takvih poruka radim ovaj posao.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap grid block" style="border-top: 1px solid var(--linija);">
      <div class="block__head">
        <p class="label">Kako radim</p>
        <h2 data-reveal="line">Tri stvari do kojih mi je stalo</h2>
      </div>
      <div class="block__body">
        <ol class="list">
          {
            principles.map(([t, d], i) => (
              <li data-reveal="fade">
                <span class="broj">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <strong>{t}</strong>
                  <span>{d}</span>
                </div>
              </li>
            ))
          }
        </ol>
        <p data-reveal="fade">
          Radim iz Šibenika, s klijentima iz cijele Hrvatske. S onima iz Šibenika i Šibensko-kninske županije rado se
          nađem i uživo. Više o tome na stranicama <a class="link" href="/izrada-web-stranica-sibenik"
            >web dizajn u Šibeniku</a
          > i <a class="link" href="/izrada-web-stranica-vodice">izrada web stranica u Vodicama</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap grid block" style="border-top: 1px solid var(--linija);">
      <div class="block__head">
        <p class="label">Alati</p>
        <h2 data-reveal="line">Tehnologije koje koristim</h2>
      </div>
      <div class="block__body">
        <ul class="list">
          {
            tehnologije.map(([t, d], i) => (
              <li data-reveal="fade">
                <span class="broj">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <strong>{t}</strong>
                  <span>{d}</span>
                </div>
              </li>
            ))
          }
        </ul>
        <p data-reveal="fade">
          Dosadašnje projekte ({brojProjekata}) možete pogledati na stranici{' '}
          <a class="link" href="/radovi">Radovi</a>, a kako razmišljam o cijenama i suradnji pročitajte na{' '}
          <a class="link" href="/blog">blogu</a>.
        </p>
      </div>
    </div>
  </section>

  <Cta title="Ispričajte mi o svom poslu." />
</Base>
