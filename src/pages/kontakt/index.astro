---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { brand } from '../../config';
import { serviceOptions } from '../../data/kontakt';
import { breadcrumbSchema, isPlaceholder, type Crumb } from '../../lib';

const crumbs: Crumb[] = [
  { name: 'Početna', href: '/' },
  { name: 'Kontakt', href: '/kontakt' },
];
const emailIsReal = !isPlaceholder(brand.email);
---

<Base
  title="Kontakt — zatražite besplatnu ponudu | Levanat, web dizajn Šibenik"
  description="Zatražite besplatnu ponudu za izradu web stranice, SEO optimizaciju ili AI chatbot. Web dizajner iz Šibenika, za klijente iz cijele Hrvatske."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero glava={2} crumbs={crumbs} label="Kontakt">
    <h1>Zatražite <em>besplatnu</em> ponudu</h1>
    <p class="lead">
      Napišite nekoliko rečenica o svom poslu i o tome što Vam treba. Javit ću Vam se s pitanjima i ponudom, bez ikakve
      obveze.
    </p>
  </PageHero>

  <section class="section">
    <div class="wrap grid contact">
      <aside class="contact__aside">
        <dl>
          <div>
            <dt class="mono">E-mail</dt>
            <dd>{emailIsReal ? <a class="link" href={`mailto:${brand.email}`}>{brand.email}</a> : brand.email}</dd>
          </div>
          <div>
            <dt class="mono">Lokacija</dt>
            <dd>Šibenik, Hrvatska</dd>
          </div>
          <div>
            <dt class="mono">Područje rada</dt>
            <dd>Cijela Hrvatska, uživo u Šibensko-kninskoj županiji</dd>
          </div>
        </dl>
        <p class="muted">
          Nije Vam do forme? Pošaljite e-mail. Dovoljno je reći čime se bavite i imate li već domenu ili Facebook
          stranicu.
        </p>
      </aside>

      <form class="contact__form form" id="obrazac" action="/api/kontakt" method="post" novalidate data-form>
        <div class="koraci__napredak" hidden data-koraci-napredak>
          <span class="mono" data-korak-broj>Korak 1 od 4</span>
          <span class="koraci__traka" aria-hidden="true"><span></span></span>
        </div>

        <div class="korak" data-korak>
          <label class="korak__pitanje" for="ime">Dobar dan! Kako se zovete?</label>
          <div class="field">
            <input id="ime" name="ime" type="text" autocomplete="name" required minlength="2" maxlength="100" placeholder="Ime i prezime" aria-describedby="ime-greska" />
            <p class="field__error" id="ime-greska" aria-live="polite"></p>
          </div>
        </div>

        <fieldset class="korak" data-korak aria-describedby="usluga-greska">
          <legend class="korak__pitanje">Drago mi je<span data-ime-pozdrav></span>. Što Vas zanima?</legend>
          <div class="korak__izbor">
            {
              serviceOptions.map((o, i) => (
                <label class="korak__opcija">
                  <input type="radio" name="usluga" value={o} required={i === 0} />
                  <span>{o}</span>
                </label>
              ))
            }
          </div>
          <p class="field__error" id="usluga-greska" aria-live="polite"></p>
        </fieldset>

        <div class="korak" data-korak>
          <label class="korak__pitanje" for="poruka">Ukratko mi opišite čime se bavite i što Vam treba.</label>
          <div class="field">
            <textarea id="poruka" name="poruka" required minlength="10" maxlength="5000" rows="6" placeholder="Npr. imam obrt u Šibeniku, trenutno samo Facebook stranicu…" aria-describedby="poruka-greska"></textarea>
            <p class="field__error" id="poruka-greska" aria-live="polite"></p>
          </div>
        </div>

        <div class="korak" data-korak>
          <p class="korak__pitanje">Gdje Vam mogu poslati ponudu?</p>
          <div class="form__row">
            <div class="field">
              <label for="email">E-mail</label>
              <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="email-greska" />
              <p class="field__error" id="email-greska" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="telefon">Telefon <span class="muted">(nije obavezno)</span></label>
              <input id="telefon" name="telefon" type="tel" autocomplete="tel" inputmode="tel" maxlength="25" aria-describedby="telefon-greska" />
              <p class="field__error" id="telefon-greska" aria-live="polite"></p>
            </div>
          </div>
        </div>

        <div class="form__hp" aria-hidden="true">
          <label for="web">Ne ispunjavajte ovo polje</label>
          <input id="web" name="web" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="t" value="" data-form-time />

        <div class="koraci__gumbi" hidden data-koraci-gumbi>
          <button type="button" class="koraci__natrag link" data-natrag>← Natrag</button>
          <button type="button" class="btn" data-dalje>Dalje <span class="btn__arrow" aria-hidden="true">→</span></button>
        </div>

        <div class="form__foot" data-form-foot>
          <button class="btn" type="submit">
            <span data-submit-label>Pošaljite upit</span>
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
          <p class="form__status" role="status" aria-live="polite" data-form-status></p>
          <p class="form__note">
            Podatke iz forme koristim isključivo da bih Vam odgovorio na upit. Više u{' '}
            <a class="link" href="/pravila-privatnosti">pravilima privatnosti</a>.
          </p>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  import { initForm } from '../../scripts/form';
  initForm();
</script>
