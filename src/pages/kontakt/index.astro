---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AvionForma from '../../components/AvionForma.astro';
import Nap from '../../components/Nap.astro';
import { breadcrumbSchema, type Crumb } from '../../lib';

const crumbs: Crumb[] = [
  { name: 'Početna', href: '/' },
  { name: 'Kontakt', href: '/kontakt' },
];
---

<Base
  title="Kontakt: web dizajner Šibenik, besplatna ponuda | Levanat"
  description="Kontakt za izradu web stranice, lokalni SEO ili AI chatbot. Web dizajner iz Šibenika za obrte i male firme. Zatražite besplatnu ponudu!"
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero crumbs={crumbs} label="Kontakt">
    <h1>Zatražite <em>besplatnu</em> ponudu</h1>
    <p class="lead">
      Kontakt forma je ispod, na listu papira. Upišite tko ste i čime se bavite, a papir će se presaviti u avion i
      odletjeti meni. Javit ću Vam se s pitanjima i ponudom, bez ikakve obveze.
    </p>
  </PageHero>

  <section class="section">
    <div class="wrap grid contact">
      <aside class="contact__aside">
        <Nap oblik="opis" />
        <dl>
          <div>
            <dt class="mono">Područje rada</dt>
            <dd>
              <a class="link" href="/izrada-web-stranica-sibenik">Šibenik</a>,
              <a class="link" href="/izrada-web-stranica-vodice">Vodice</a> i cijela Šibensko-kninska županija uživo,
              ostatak Hrvatske na daljinu
            </dd>
          </div>
        </dl>
        <p class="muted">
          Radije klasično? Pošaljite e-mail. Dovoljno je reći čime se bavite i imate li već domenu ili Facebook
          stranicu.
        </p>
      </aside>

      <AvionForma class="contact__form" />
    </div>
  </section>
</Base>

<script>
  import { initAvion } from '../../scripts/avion';
  initAvion();
</script>
