---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { seoFaq } from '../../data/faq';
import { breadcrumbSchema, faqSchema, serviceSchema, type Crumb } from '../../lib';

const crumbs: Crumb[] = [
  { name: 'Početna', href: '/' },
  { name: 'Usluge', href: '/usluge' },
  { name: 'Lokalni SEO', href: '/usluge/lokalni-seo' },
];

const work = [
  ['Tehnička osnova', 'Brzina, prikaz na mobitelu, sitemap i sve što Googleu treba kako bi stranicu pročitao bez zapreka.'],
  [
    'Ključne riječi',
    'Provjerimo kako Vas ljudi zaista traže, npr. „frizer Šibenik” ili „apartmani Vodice”, i na te pojmove složimo stranice.',
  ],
  [
    'Stranice za usluge i mjesta',
    'Svaka važna usluga i svako mjesto u kojem radite dobiju svoju stranicu, s jedinstvenim tekstom, a ne kopijom.',
  ],
  ['Naslovi i opisi', 'Title, meta opis i naslovi na stranici složeni tako da se iz rezultata pretrage odmah vidi tko ste i gdje radite.'],
  ['Strukturirani podaci', 'Schema.org oznake (LocalBusiness, usluge, česta pitanja) koje Googleu jasno kažu tko ste, gdje ste i čime se bavite.'],
  ['Dosljedni podaci', 'Isti naziv, adresa i telefon na svakoj stranici i u imenicima u kojima se pojavljujete.'],
  ['Interne poveznice', 'Stranice se međusobno povezuju opisnim poveznicama, pa Google i posjetitelji lakše nađu ono što traže.'],
];
---

<Base
  title="Lokalni SEO Šibenik — vidljivost na Googleu | Levanat"
  description="Lokalni SEO u Šibeniku za obrte i male firme: brza stranica, sadržaj za usluge i mjesta, strukturirani podaci. Zatražite besplatnu ponudu!"
  schema={[
    breadcrumbSchema(crumbs),
    faqSchema(seoFaq),
    serviceSchema({
      name: 'Lokalni SEO',
      url: '/usluge/lokalni-seo',
      description: 'Lokalna optimizacija web stranice za tražilice: tehnička osnova, sadržaj za usluge i mjesta, strukturirani podaci.',
      mjesta: ['Šibenik', 'Vodice'],
    }),
  ]}
>
  <PageHero crumbs={crumbs} label="Usluga 02">
    <h1>Lokalni SEO u Šibeniku: <em>da Vas pronađu</em> ljudi iz Vašeg kraja</h1>
    <p class="lead">
      Web stranica složena tako da Google jasno razumije čime se bavite i gdje radite, pa Vas prikaže onima koji traže
      baš to, baš ovdje.
    </p>
  </PageHero>

  <div class="wrap">
    <section class="grid block" aria-labelledby="sto-je">
      <div class="block__head">
        <p class="label">Lokalni SEO</p>
        <h2 id="sto-je" data-reveal="line">Što je lokalni SEO i zašto je važan malim poslovima?</h2>
      </div>
      <div class="block__body">
        <p class="lead" data-reveal="fade">
          Kad netko traži „frizer Šibenik” ili „servis klima Vodice”, Google prikazuje rezultate s karte i stranice koje
          najbolje odgovaraju upitu i mjestu.
        </p>
        <p data-reveal="fade">
          Lokalni SEO je skup postupaka kojima Googleu jasno pokazujemo da ste upravo Vi dobar odgovor: da postojite, da
          radite u tom mjestu i da se bavite baš time. Za mali posao to je često važnije od bilo kakvog oglašavanja,
          jer dolazi do ljudi u trenutku kad im zaista trebate.
        </p>
      </div>
    </section>

    <section class="grid block" aria-labelledby="sto-radim">
      <div class="block__head">
        <p class="label">Što radim</p>
        <h2 id="sto-radim" data-reveal="line">Lokalni SEO, korak po korak</h2>
      </div>
      <div class="block__body">
        <ul class="list">
          {
            work.map(([t, d], i) => (
              <li data-reveal="fade">
                <span class="broj">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <strong>{t}</strong>
                  <span>{d}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="grid block" aria-labelledby="iskreno">
      <div class="block__head">
        <p class="label">Iskreno</p>
        <h2 id="iskreno" data-reveal="line">SEO nije gumb koji se jednom pritisne.</h2>
      </div>
      <div class="block__body">
        <p data-reveal="fade">
          Rezultati dolaze postupno, a prvo mjesto na Googleu ne može Vam pošteno obećati nitko. Mogu Vam obećati da će
          stranica biti složena onako kako Google preporučuje, i da ćete razumjeti što je napravljeno i zašto.
          Primjer kako to izgleda u praksi su stranice za{' '}
          <a class="link" href="/izrada-web-stranica-sibenik">Šibenik</a> i{' '}
          <a class="link" href="/izrada-web-stranica-vodice">Vodice</a>.
        </p>
        <p data-reveal="fade">
          Lokalni SEO uključen je u osnovnom obliku u svaku <a class="link" href="/usluge/izrada-web-stranica"
            >izradu web stranice</a
          >. Za postojeće stranice ili opsežniji lokalni SEO javite se, pa ćemo vidjeti što ima smisla.
        </p>
      </div>
    </section>
  </div>

  <Faq items={seoFaq} label="Pitanja" title="Pitanja o lokalnom SEO-u" />
  <Cta title="Pogledajmo kako Vaša stranica stoji." />
</Base>
