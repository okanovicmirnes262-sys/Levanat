---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import { services } from '../../config';
import { breadcrumbSchema, type Crumb } from '../../lib';

const crumbs: Crumb[] = [
  { name: 'Početna', href: '/' },
  { name: 'Usluge', href: '/usluge' },
];
const main = services.filter((s) => !s.href.includes('#'));
---

<Base
  title="Usluge: izrada web stranica, SEO i AI chatbot | Levanat Šibenik"
  description="Web dizajn u Šibeniku: izrada web stranica, lokalna SEO optimizacija, AI chatbot za web stranicu i održavanje. Pomoć oko domene i hostinga uključena."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero glava={1} crumbs={crumbs} label="Usluge">
    <h1>Usluge web dizajna, <em>od prve skice</em> do održavanja</h1>
    <p class="lead">
      Sve što malom poslu treba kako bi ga pronašli na internetu, na jednom mjestu. Bez posrednika: sa mnom razgovarate od
      prvog upita do predaje.
    </p>
  </PageHero>

  <section class="section--tight">
    <div class="wrap">
      <ol class="services">
        {
          main.map((s) => (
            <li class="service">
              <a href={s.href}>
                <span class="service__n mono">{s.n}</span>
                <h2 class="service__title">{s.title}</h2>
                <p class="service__short">{s.short}</p>
                <span class="service__meta mono">{s.meta}</span>
                <span class="service__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="odrzavanje" aria-labelledby="odrzavanje-naslov">
    <div class="wrap grid upkeep">
      <div class="upkeep__head">
        <p class="label">04 · Održavanje</p>
        <h2 id="odrzavanje-naslov" data-reveal="line">Nakon izrade birate Vi.</h2>
        <p class="muted" data-reveal="fade" style="margin-top: 1.25rem; max-width: 30em;">
          Održavanje nije obavezno. Neki klijenti žele da se netko brine o stranici, a drugi je radije preuzmu sami. Oba
          su izbora u redu.
        </p>
      </div>
      <div class="upkeep__options">
        <div class="upkeep__option" data-reveal="fade">
          <span class="broj">a</span>
          <h3>Mjesečno održavanje</h3>
          <p>
            Za mjesečnu naknadu brinem se o stranici: ažuriranja, sigurnosne kopije i izmjene koje Vam zatrebaju.
            Pošaljete mi što treba promijeniti, a ja to sredim.
          </p>
        </div>
        <div class="upkeep__option" data-reveal="fade">
          <span class="broj">b</span>
          <h3>Jednokratna predaja</h3>
          <p>
            Cijeli projekt, sa svim pristupima, predajem u Vaše ruke. Nemate mjesečnih obveza prema meni, a za kasnije
            izmjene uvijek se možemo dogovoriti posebno.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;" aria-labelledby="ukljuceno-naslov">
    <div class="wrap grid upkeep">
      <div class="upkeep__head">
        <p class="label">Uključeno</p>
        <h2 id="ukljuceno-naslov" data-reveal="line">U svakoj izradi, bez doplate</h2>
      </div>
      <div class="upkeep__options">
        <div class="upkeep__option" data-reveal="fade">
          <span class="broj">01</span>
          <h3>Domena</h3>
          <p>Pomoć oko odabira i kupnje domene na Vaše ime.</p>
        </div>
        <div class="upkeep__option" data-reveal="fade">
          <span class="broj">02</span>
          <h3>Hosting</h3>
          <p>Postavljanje hostinga i povezivanje s domenom, kako bi stranica radila brzo i pouzdano.</p>
        </div>
        <div class="upkeep__option" data-reveal="fade">
          <span class="broj">03</span>
          <h3>Google Business profil</h3>
          <p>Izrada profila, kako biste bili vidljivi u Google tražilici i na Google kartama.</p>
        </div>
      </div>
    </div>
  </section>

  <Cta />
</Base>
