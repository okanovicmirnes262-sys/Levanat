---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import Plima from '../components/Plima.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import WorkItem from '../components/WorkItem.astro';
import { brand, services } from '../config';
import { homeFaq } from '../data/faq';
import { radovi } from '../data/radovi';
import { kipovi } from '../data/kamen';
import Kostur from '../components/Kostur.astro';
import { sibencani } from '../data/sibenik';
import { abs, faqSchema, splitWords } from '../lib';

const t1 = splitWords('Web stranica koja jasno pokazuje');
const t2 = splitWords('tko ste i što nudite.', t1.next);

const steps = [
  {
    title: 'Besplatan razgovor i ponuda',
    text: 'Ukratko mi opišete čime se bavite i što Vam treba. Popričamo, a ja Vam pošaljem jasnu ponudu u kojoj piše što dobivate. Bez obveze.',
  },
  {
    title: 'Dizajn i izrada',
    text: 'Dizajn slažem za Vas, ne iz gotovog predloška. Usput Vam šaljem međuverzije, pa na vrijeme vidite kako stranica nastaje i možete reći što želite drukčije.',
  },
  {
    title: 'Domena, hosting i Google Business profil',
    text: 'Pomognem Vam kupiti domenu i postaviti hosting, povežem sve što treba i izradim Vaš Google Business profil, da se Vaš posao prikazuje i na Google kartama.',
  },
  {
    title: 'Predaja ili održavanje',
    text: 'Po Vašem izboru: cijeli projekt predajem u Vaše ruke ili se i dalje brinem o stranici uz mjesečno održavanje, s uključenim izmjenama.',
  },
];

// Stranica spominje poznate Šibenčane (pomaže Googleu povezati stranicu sa Šibenikom)
const wiki: Record<string, string> = {
  'Juraj Dalmatinac': 'https://hr.wikipedia.org/wiki/Juraj_Dalmatinac',
  'Faust Vrančić': 'https://hr.wikipedia.org/wiki/Faust_Vran%C4%8Di%C4%87',
  'Ante Šupuk': 'https://hr.wikipedia.org/wiki/Ante_%C5%A0upuk',
  'Dražen Petrović': 'https://hr.wikipedia.org/wiki/Dra%C5%BEen_Petrovi%C4%87',
};
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': abs('/') + '#stranica',
  url: abs('/'),
  name: 'Izrada web stranica Šibenik | Levanat',
  inLanguage: 'hr-HR',
  about: { '@type': 'City', name: 'Šibenik' },
  mentions: sibencani.map((o) => ({ '@type': 'Person', name: o.ime, description: o.uloga, sameAs: wiki[o.ime] })),
};

// Val za liniju plime u procesu
const valH = Array.from({ length: 41 }, (_, i) => `${i * 25},${(10 + Math.sin(i * 0.9) * 5).toFixed(1)}`).join(' L');
const valV = Array.from({ length: 41 }, (_, i) => `${(6 + Math.sin(i * 0.9) * 4).toFixed(1)},${i * 25}`).join(' L');
---

<Base
  title="Izrada web stranica Šibenik | Levanat — web dizajn"
  description="Izrada web stranica u Šibeniku za male poduzetnike i obrte. Brza, pregledna stranica, lokalni SEO i Google Business profil. Zatražite besplatnu ponudu."
  schema={[faqSchema(homeFaq), pageSchema]}
>
  <!-- Hero: kostur web stranice koji se crta dok skrolate, a na kraju se popuni -->
  <section class="scena" aria-labelledby="naslov" data-scena>
    <div class="scena__kadar">
      <div class="odsjaj" aria-hidden="true"></div>
      <div class="scena__kostur"><Kostur /></div>
      <div class="scena__veo" data-scena-veo></div>
      <div class="scena__tekst" data-scena-tekst>
    <div class="wrap grid hero__content">
      <p class="hero__eyebrow mono">
        <span data-greeting>Dobro došli.</span>
        <span>Web dizajn · Šibenik</span>
      </p>

      <h1 id="naslov" class="hero__title">
        <Fragment set:html={t1.html} />{' '}<em set:html={t2.html} />
      </h1>

      <div class="hero__foot">
        <p class="lead">
          Izrađujem web stranice za obrtnike, male firme i poduzetnike iz Šibenika i cijele Hrvatske.
        </p>
        <p class="hero__opis">
          Pregledan dizajn, brzo učitavanje, prilagodba mobitelu i tekst koji na jednom mjestu kaže čime se bavite, gdje
          ste i kako Vas dobiti.
        </p>
        <div class="hero__actions">
          <a class="btn" href="/kontakt">
            {brand.primaryCta}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="link" href="/radovi">Pogledajte radove</a>
        </div>
      </div>

      <dl class="hero__meta">
        <div>
          <dt class="mono">Šibenik</dt>
          <dd>43°44′ N, 15°53′ E</dd>
        </div>
      </dl>
    </div>
      </div>
      <Plima polozaj="dolje" boja="var(--kamen)" />
    </div>
  </section>

  <!-- Problem -->
  <section class="section" aria-labelledby="problem-naslov">
    <div class="wrap grid problem">
      <div class="problem__text">
        <p class="label">01 · Zašto stranica</p>
        <h2 id="problem-naslov" data-reveal="line">Društvene mreže i web stranica <em>rade različite poslove.</em></h2>
        <p data-reveal="fade">
          Facebook i Instagram dobri su za obavijesti, fotografije i razgovor s ljudima koji Vas već prate. Ali objave
          brzo potonu, a važne informacije se izgube među njima.
        </p>
        <p data-reveal="fade">
          Web stranica je mjesto gdje sve stoji složeno: koje usluge nudite, gdje radite, kada ste dostupni i kako Vas
          kontaktirati. Na nju možete uputiti ljude s društvenih mreža, iz Google profila ili iz poruke.
        </p>
        <p data-reveal="fade">Stranica ne zamjenjuje društvene mreže. Nadopunjuje ih.</p>
      </div>

      <figure class="serp" data-serp aria-labelledby="serp-opis">
        <div class="serp__frame">
          <div class="serp__bar" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none"
              ><circle cx="7" cy="7" r="5.25" stroke="currentColor" stroke-width="1.2"></circle><path
                d="M11 11l3.5 3.5"
                stroke="currentColor"
                stroke-width="1.2"></path></svg
            >
            <span>vodoinstalater šibenik</span>
            <span class="serp__caret"></span>
          </div>

          <div class="serp__stanje serp__stanje--prije">
            <p class="serp__oznaka mono">Samo Facebook</p>
            <div class="serp__rezultat">
              <p class="serp__url">facebook.com › vodoinstalater.marko</p>
              <p class="serp__title">Vodoinstalater Marko | Facebook</p>
              <p class="serp__desc">Prijavite se ili se registrirajte da biste vidjeli više sadržaja…</p>
            </div>
            <p class="serp__ishod">Posjetitelj prvo naiđe na prozor za prijavu.</p>
          </div>

          <div class="serp__stanje serp__stanje--poslije">
            <p class="serp__oznaka mono">Vlastita stranica</p>
            <div class="serp__rezultat">
              <p class="serp__url">vodoinstalater-marko.hr</p>
              <p class="serp__title">Vodoinstalater u Šibeniku · Popravci i ugradnja | Marko</p>
              <p class="serp__desc">
                Popravci, ugradnja i hitne intervencije u Šibeniku i okolici. Usluge, radno vrijeme i kontakt na jednom
                mjestu.
              </p>
            </div>
            <p class="serp__ishod">Posjetitelj odmah vidi usluge, radno vrijeme i kontakt.</p>
          </div>
        </div>
        <figcaption id="serp-opis" class="mono">
          Ilustracija: isti obrt u rezultatima pretraživanja, prije i poslije vlastite stranice.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Šibenik: četiri Šibenčanina -->
  <section class="friz more" aria-labelledby="friz-naslov" data-friz data-svjetlo>
    <Plima polozaj="gore" />
    <div class="odsjaj" aria-hidden="true"></div>
    <div class="friz__pin">
      <div class="wrap grid friz__head">
        <p class="label">02 · Šibenik</p>
        <h2 id="friz-naslov" data-reveal="line">Radim iz Šibenika.</h2>
        <p class="friz__uvod" data-reveal="fade">Četiri Šibenčanina i ono što od njih uzimam u svoj posao.</p>
      </div>
      <div class="friz__traka" tabindex="0" aria-label="Poznati Šibenčani; pomičite vodoravno">
        {
          sibencani.map((o) => (
            <Fragment>
              <figure class="friz__glava">
                <Picture src={o.src} alt={o.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[320, 520, 760]} sizes="(min-width: 900px) 330px, 56vw" loading="lazy" decoding="async" />
                <figcaption>
                  <span class="mono friz__godine"><span>{o.uloga}</span><span>{o.godine}</span></span>
                  <h3 class="friz__ime">{o.ime}</h3>
                  <p class="friz__opis">{o.tekst}</p>
                </figcaption>
              </figure>
              <div class="friz__misao">
                <p>{o.misao[0]}</p>
                <p>{o.misao[1]}</p>
              </div>
            </Fragment>
          ))
        }
      </div>
      <div class="wrap">
        <div class="friz__napredak" aria-hidden="true"><span></span></div>
      </div>
    </div>
    <Plima polozaj="dolje" boja="var(--kamen)" />
  </section>

  <!-- Usluge -->
  <section class="section" aria-labelledby="usluge-naslov" style="padding-top: calc(var(--section) + var(--tide-h) * 0.5);">
    <div class="odsjaj" aria-hidden="true" style="--odsjaj: .08"></div>
    <div class="wrap" style="position: relative">
      <div class="grid section-head">
        <p class="label">03 · Usluge</p>
        <h2 id="usluge-naslov" data-reveal="line">
          Izrada stranice <em>i sve što uz nju ide.</em>
        </h2>
      </div>

      <ol class="services">
        {
          services.map((s) => (
            <li class="service">
              <a href={s.href}>
                <span class="service__n broj">{s.n}</span>
                <h3 class="service__title">{s.title}</h3>
                <p class="service__short">{s.short}</p>
                <span class="service__meta mono">{s.meta}</span>
                <span class="service__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="grid included">
        <p class="label">Uključeno u svaku izradu</p>
        <p data-reveal="fade">
          Pomoć oko kupnje domene i postavljanja hostinga te izrada Google Business profila. Tehničke stvari rješavam ja,
          a Vi dobivate pristupe i objašnjenje što je gdje.
        </p>
      </div>
    </div>
  </section>

  <!-- Proces: linija plime -->
  <section class="section" aria-labelledby="proces-naslov" style="background-color: var(--kamen-svijetli); padding-top: calc(var(--section) * 0.8);">
    <div class="wrap">
      <div class="grid section-head">
        <p class="label">04 · Proces</p>
        <h2 id="proces-naslov" data-reveal="line">Kako izgleda suradnja.</h2>
      </div>

      <ol class="process" data-process>
        <svg class="process__val process__val--h" viewBox="0 0 1000 20" preserveAspectRatio="none" aria-hidden="true">
          <path class="trag" d={`M${valH}`}></path>
          <path class="plima-crta" d={`M${valH}`} pathLength="1"></path>
        </svg>
        <svg class="process__val process__val--v" viewBox="0 0 12 1000" preserveAspectRatio="none" aria-hidden="true">
          <path class="trag" d={`M${valV}`}></path>
          <path class="plima-crta" d={`M${valV}`} pathLength="1"></path>
        </svg>
        {
          steps.map((s, i) => (
            <li class="process__step">
              <span class="process__num broj" aria-hidden="true">{i + 1}</span>
              <h3><span class="sr-only">Korak {i + 1}: </span>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Sv. Mihovil nad riječju „Detalji” -->
  <section class="mihovil" aria-labelledby="o-meni-naslov">
    <div class="odsjaj" aria-hidden="true" style="--odsjaj: .1"></div>
    <div class="mihovil__rijec" data-rijec="Detalji" aria-hidden="true"></div>
    <figure class="mihovil__kip">
      <Picture src={kipovi.mihovil.src} alt={kipovi.mihovil.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[420, 640, 900]} sizes="(min-width: 900px) 34vw, 62vw" loading="lazy" decoding="async" />
    </figure>
    <div class="wrap grid mihovil__tekst">
      <blockquote class="mihovil__citat" data-reveal="fade">
        <p>„Tek sam sad vidio ovo, pa ti si i o tome razmišljao.”</p>
        <footer class="mono muted">Poruka tjedan dana nakon predaje</footer>
      </blockquote>
      <div class="mihovil__o">
        <p class="label">05 · O meni</p>
        <h2 id="o-meni-naslov" data-reveal="line" style="font-size: clamp(1.9rem, 1.3rem + 2vw, 3rem)">Sitni detalji čine razliku.</h2>
        <p data-reveal="fade">
          Ja sam Mirnes, web dizajner iz Šibenika. Svaku stranicu radim sam, od prvog razgovora do predaje, pa uvijek
          znate s kim razgovarate. Puno vremena potrošim na sitnice: razmake, tekst, ponašanje na mobitelu. Većina
          ljudi ih ne primijeti odmah, ali se po njima vidi razlika.
        </p>
        <p data-reveal="fade"><a class="link" href="/o-meni">Više o meni →</a></p>
      </div>
    </div>
  </section>

  <!-- Radovi -->
  <section class="section" aria-labelledby="radovi-naslov" style="padding-top: 0;">
    <div class="wrap">
      <div class="grid section-head">
        <p class="label">06 · Radovi</p>
        <h2 id="radovi-naslov" data-reveal="line">Odabrani radovi</h2>
        <p class="section-head__text muted" data-reveal="fade">
          Projekti na kojima trenutno radim. Dok ne pređu na svoje domene, označeni su kao „U izradi”.
        </p>
      </div>
      <div class="works">
        {radovi.slice(0, 2).map((rad, i) => <WorkItem rad={rad} index={i} />)}
      </div>
      <p style="margin-top: clamp(3rem, 6vw, 5rem);">
        <a class="link" href="/radovi">Svi radovi →</a>
      </p>
    </div>
  </section>

  <Faq
    items={homeFaq}
    label="07 · Pitanja"
    intro='Ne vidite svoje pitanje? <a class="link" href="/kontakt">Pošaljite mi ga</a>, odgovaram osobno.'
  />

  <Cta />
</Base>
