---
// Pozornica s kamenim glavama. Slike su uvijek u HTML-u (rezerva i SEO);
// WebGL ih, kad je dostupan, crta preko njih uz svjetlo koje prati kursor.
import { Picture, getImage } from 'astro:assets';
import type { Glava } from '../data/kamen';

interface Props {
  glave: Glava[];
  prioritet?: boolean;
  sizes?: string;
}
const { glave, prioritet = false, sizes = '(min-width: 1100px) 44vw, 78vw' } = Astro.props;

const items = await Promise.all(
  glave.map(async (g) => ({
    g,
    normal: (await getImage({ src: g.normal, format: 'webp', width: 900, quality: 82 })).src,
  })),
);
---

<div class="reljef" data-reljef>
  {
    items.map(({ g, normal }, i) => (
      <figure class={`reljef__slika reljef__slika--${i + 1}`}>
        <Picture
          src={g.src}
          alt={g.alt}
          formats={['avif', 'webp']} fallbackFormat="webp"
          widths={i === 0 ? [480, 760, 1100] : [320, 520]}
          sizes={i === 0 ? sizes : '(min-width: 1100px) 20vw, 1px'}
          loading={prioritet && i === 0 ? 'eager' : 'lazy'}
          fetchpriority={prioritet && i === 0 ? 'high' : 'auto'}
          decoding="async"
          data-relief
          data-normal={normal}
        />
      </figure>
    ))
  }
  <div class="reljef__svjetlo"></div>
  <canvas></canvas>
</div>
