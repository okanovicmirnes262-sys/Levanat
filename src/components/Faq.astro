---
import type { Faq } from '../data/faq';

interface Props {
  items: Faq[];
  title?: string;
  intro?: string;
  label?: string;
}
const { items, title = 'Česta pitanja', intro, label = 'Pitanja' } = Astro.props;
---

<section class="section" aria-labelledby="faq-naslov">
  <div class="wrap grid faq">
    <div class="faq__head">
      <p class="label">{label}</p>
      <h2 id="faq-naslov" data-reveal="line">{title}</h2>
      {intro && <p class="muted" data-reveal="fade" set:html={intro} />}
    </div>
    <div class="faq__list">
      {
        items.map((f) => (
          <details class="faq__item" name="faq">
            <summary>
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
