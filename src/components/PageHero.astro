---
import Reljef from './Reljef.astro';
import Plima from './Plima.astro';
import { glave } from '../data/kamen';
import type { Crumb } from '../lib';

interface Props {
  crumbs: Crumb[];
  label?: string;
  /** indeks glave s friza (0–4) koja stoji uz naslov */
  glava?: number;
}
const { crumbs, label, glava = 0 } = Astro.props;
---

<header class="page-hero more" data-svjetlo>
  <Reljef glave={[glave[glava % glave.length]]} prioritet sizes="(min-width: 1000px) 34vw, 70vw" />
  <div class="odsjaj" aria-hidden="true"></div>
  <div class="wrap grid page-hero__grid">
    <nav class="crumbs mono" aria-label="Putanja">
      <ol>
        {
          crumbs.map((c, i) => (
            <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))
        }
      </ol>
    </nav>
    {label && <p class="label">{label}</p>}
    <slot />
  </div>
  <Plima polozaj="dolje" boja="var(--kamen)" />
</header>
