---
import { brand, lokacije, nav, services } from '../config';
import { stvarno, windLetters } from '../lib';
import Nap from './Nap.astro';

const year = new Date().getFullYear();
const oib = stvarno(brand.oib);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="grid footer__top">
      <div class="footer__intro">
        <p class="mono">Levanat · web dizajn · Šibenik</p>
        <p>
          Web stranice, lokalni SEO i AI chatbotovi za male poduzetnike, obrtnike i firme. Iz Šibenika, za cijelu
          Hrvatsku.
        </p>
      </div>

      <div class="footer__col">
        <h2>Stranice</h2>
        <ul>
          <li><a class="link" href="/">Početna</a></li>
          {
            nav.map((item) => (
              <li>
                <a class="link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col">
        <h2>Usluge</h2>
        <ul>
          {
            services.map((s) => (
              <li>
                <a class="link" href={s.href}>
                  {s.title}
                </a>
              </li>
            ))
          }
          {
            lokacije.map((l) => (
              <li>
                <a class="link" href={l.href}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col">
        <h2>Kontakt</h2>
        <ul>
          <Nap />
          <li><a class="link" href="/kontakt">{brand.primaryCta}</a></li>
        </ul>
      </div>
    </div>

    <p class="footer__word" aria-hidden="true" set:html={windLetters('Levanat')} />

    <div class="footer__bottom">
      <p>© {year} Levanat · {brand.businessDetails}{oib ? ` · OIB ${oib}` : ''}</p>
      <ul class="footer__pravno">
        <li><a class="link" href="/pravila-privatnosti">Pravila privatnosti</a></li>
        <li><a class="link" href="/uvjeti-koristenja">Uvjeti korištenja</a></li>
        <li><a class="link" href="/impresum">Impresum</a></li>
      </ul>
    </div>

    <details class="colophon">
      <summary class="mono"><span>Kolofon</span></summary>
      <p>
        Sve je složeno u jednom fontu, Fraunces, koji se učitava s ove stranice, bez vanjskih servisa. Arkanđeo
        Mihovil snimljen je na katedrali sv. Jakova, djelu Jurja Dalmatinca. Ako ste pažljivo gledali,
        primijetili ste da valovi na stranici putuju zdesna nalijevo. Tako puše levanat. Stranica ne koristi
        kolačiće.
      </p>
    </details>
  </div>
</footer>
