---
// Mali linijski motiv uz misao svakog Šibenčanina (u bronci, bez teksta).
// Animira se jednom, kad misao uđe na ekran (kretanje.ts → .is-motiv); bez JS-a samo stoji.
interface Props {
  motiv: 'juraj' | 'faust' | 'supuk' | 'petrovic';
}
const { motiv } = Astro.props;
---

{
  motiv === 'faust' && (
    <svg class="motiv motiv--faust" viewBox="0 0 48 48" aria-hidden="true">
      <g class="motiv__padobran">
        {/* Homo volans: četvrtasto platno na okviru, užad i čovjek */}
        <path d="M9 11 Q24 5 39 11 L36 19 Q24 15 12 19 Z" />
        <path d="M12 19 L22.5 33 M36 19 L25.5 33 M9 11 L22 33 M39 11 L26 33" class="motiv__tanko" />
        <circle cx="24" cy="34.5" r="2" />
        <path d="M24 36.5 V42 M24 38.5 L21 40.5 M24 38.5 L27 40.5 M24 42 L22 46 M24 42 L26 46" />
      </g>
    </svg>
  )
}
{
  motiv === 'supuk' && (
    <svg class="motiv motiv--supuk" viewBox="0 0 48 48" aria-hidden="true">
      <circle class="motiv__sjaj" cx="24" cy="19" r="15" />
      <path d="M24 7 A11 11 0 0 1 31 26.5 V31 H17 V26.5 A11 11 0 0 1 24 7 Z" />
      <path d="M19 35 H29 M20.5 38.5 H27.5 M22.5 42 H25.5" />
      <path class="motiv__nit" d="M20.5 23 V18.5 L22.5 15.5 L24 18.5 L25.5 15.5 L27.5 18.5 V23" />
    </svg>
  )
}
{
  motiv === 'petrovic' && (
    <svg class="motiv motiv--petrovic" viewBox="0 0 48 48" aria-hidden="true">
      <g class="motiv__dres">
        <path d="M17 7 L9 11.5 L12 19 L15.5 17.5 V41 H32.5 V17.5 L36 19 L39 11.5 L31 7 Q24 12 17 7 Z" />
        <text x="24" y="33" text-anchor="middle">4</text>
      </g>
    </svg>
  )
}
