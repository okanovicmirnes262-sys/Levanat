---
// Pokazni primjer asistenta u sadržaju stranice (koristi istu bazu znanja).
---

<div class="chat" id="demo-chat" data-chat-demo data-lenis-prevent></div>

<script>
  import { mountChat } from '../scripts/asistent';
  document.querySelectorAll<HTMLElement>('[data-chat-demo]').forEach((el) => mountChat(el, { status: 'Pokazni primjer' }));
</script>
