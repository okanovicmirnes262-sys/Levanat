# Resend API ključ (https://resend.com → API Keys)
RESEND_API_KEY=
# Adresa na koju stižu upiti s kontakt forme
CONTACT_TO_EMAIL=
# Pošiljatelj; mora biti na domeni potvrđenoj u Resendu, npr. "Levanat <upiti@levanat.hr>"
CONTACT_FROM_EMAIL=
